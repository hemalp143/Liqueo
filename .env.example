# Liqueo Configuration

# OpenAI API Key (for embeddings and synthesis)
OPENAI_API_KEY=sk-...

# Anthropic API Key (for synthesis and embeddings)
ANTHROPIC_API_KEY=sk-ant-...

# Storage directory
LIQUEO_STORAGE_DIR=.liqueo

# Default embedding model: "openai" or "anthropic"
LIQUEO_EMBEDDING_MODEL=anthropic

# Default synthesis model: "openai" or "anthropic"
LIQUEO_SYNTHESIS_MODEL=anthropic

# Debug mode
DEBUG=false
