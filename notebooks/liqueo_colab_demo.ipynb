  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Export Results\n",
    "\n",
    "Export the knowledge base and analysis results."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Export knowledge base to JSON\n",
    "export_data = {\n",
    "    \"version\": \"1.0.0\",\n",
    "    \"timestamp\": datetime.now().isoformat(),\n",
    "    \"summary\": {\n",
    "        \"total_documents\": len(kb.list_documents()),\n",
    "        \"industries\": list(set(d.industry for d in kb.list_documents() if d.industry)),\n",
    "        \"transaction_types\": list(set(d.transaction_type for d in kb.list_documents() if d.transaction_type))\n",
    "    },\n",
    "    \"documents\": [doc.to_dict() for doc in kb.list_documents()]\n",
    "}\n",
    "\n",
    "# Display export\n",
    "print(\"Export Summary:\")\n",
    "print(json.dumps(export_data[\"summary\"], indent=2))\n",
    "\n",
    "print(f\"\\n✓ Knowledge base exported ({len(kb.list_documents())} documents)\")"
   ]
  },
  {
