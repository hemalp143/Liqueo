   "source": [
    "# Liqueo: Knowledge Discovery & Reuse for Financial Consultants\n",
    "\n",
    "**Interactive demo for Google Colab**\n",
    "\n",
    "This notebook demonstrates the complete Liqueo system including:\n",
    "- Knowledge base management\n",
    "- Semantic search with embeddings\n",
    "- Intelligent recommendations\n",
    "- AI-powered synthesis and insights"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup & Installation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install dependencies\n",
    "!pip install -q anthropic openai click rich numpy pandas pytest langchain faiss-cpu"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clone Liqueo from GitHub\n",
    "!git clone -q https://github.com/hemalp143/Liqueo.git\n",
    "import sys\n",
    "sys.path.insert(0, '/content/Liqueo')\n",
    "print(\"✓ Liqueo cloned and imported successfully\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import Liqueo components\n",
    "from liqueo.core import Document, KnowledgeBase, generate_doc_id\n",
    "from liqueo.embeddings import EmbeddingsManager\n",
    "from liqueo.recommender import RecommendationEngine\n",
    "from liqueo.synthesizer import KnowledgeSynthesizer\n",
    "from datetime import datetime\n",
    "from IPython.display import HTML, display\n",
    "import json\n",
    "\n",
    "print(\"✓ All Liqueo modules imported\")\n",
    "print(\"\\nLiqueo Components:\")\n",
    "print(\"  - Document: Data model for consulting engagements\")\n",
    "print(\"  - KnowledgeBase: Persistent storage and retrieval\")\n",
    "print(\"  - EmbeddingsManager: Semantic search capability\")\n",
    "print(\"  - RecommendationEngine: Find similar past engagements\")\n",
    "print(\"  - KnowledgeSynthesizer: Generate insights using LLMs\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Initialize Knowledge Base\n",
    "\n",
    "Set up a sample knowledge base with consulting engagements."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize knowledge base\n",
    "kb = KnowledgeBase()\n",
    "\n",
    "# Create sample documents\n",
    "docs_data = [\n",
    "    {\n",
    "        \"title\": \"SaaS Company Acquisition - Tech Stack Valuation\",\n",
    "        \"industry\": \"Technology\",\n",
    "        \"transaction_type\": \"M&A\",\n",
    "        \"value\": 2.5,\n",
    "        \"duration\": 8,\n",
    "        \"client\": \"Growth Equity Firm\",\n",
    "        \"content\": \"Acquired high-growth SaaS company. Identified $50M technology premium through deep technical analysis. Evaluated cloud infrastructure, API architecture, and data security. Secured favorable valuation by highlighting technical risks and mitigated infrastructure costs.\",\n",
    "        \"outcomes\": \"Identified $50M technology premium; secured favorable valuation; reduced risk through technical due diligence\",\n",
    "        \"approach\": \"Deep-dive technical analysis with cloud infrastructure focus\"\n",
    "    },\n",
    "    {\n",
    "        \"title\": \"Retail Chain Restructuring - Technology Consolidation\",\n",
    "        \"industry\": \"Retail\",\n",
    "        \"transaction_type\": \"Restructuring\",\n",
    "        \"value\": 1.8,\n",
    "        \"duration\": 12,\n",
    "        \"client\": \"Major US Retailer\",\n",
    "        \"content\": \"Post-merger integration of 200+ stores with redundant technology platforms. Consolidated e-commerce, POS, and inventory systems. Achieved 35% IT cost reduction through legacy system modernization and cloud migration.\",\n",
    "        \"outcomes\": \"35% IT cost reduction; improved omnichannel capabilities; workforce redeployment\",\n",
    "        \"approach\": \"Process optimization with technology modernization\"\n",
    "    },\n",
    "    {\n",
    "        \"title\": \"Investment Bank Back-Office Reorganization\",\n",
    "        \"industry\": \"Financial Services\",\n",
    "        \"transaction_type\": \"Restructuring\",\n",
    "        \"value\": 3.2,\n",
    "        \"duration\": 10,\n",
    "        \"client\": \"Global Investment Bank\",\n",
    "        \"content\": \"Reorganized back-office operations across 5 continents. Implemented shared service centers, automated compliance reporting, and consolidated trading infrastructure. Improved operational efficiency while maintaining regulatory compliance.\",\n",
    "        \"outcomes\": \"40% reduction in back-office costs; improved compliance automation; 200+ FTE reductions\",\n",
    "        \"approach\": \"Global operating model redesign with automation focus\"\n",
    "    }\n",
    "]\n",
    "\n",
    "# Add documents to knowledge base\n",
    "for doc_data in docs_data:\n",
    "    doc = Document(\n",
    "        id=generate_doc_id(doc_data[\"title\"], datetime.now()),\n",
    "        title=doc_data[\"title\"],\n",
    "        content=doc_data[\"content\"],\n",
    "        industry=doc_data[\"industry\"],\n",
    "        transaction_type=doc_data[\"transaction_type\"],\n",
    "        engagement_value=doc_data[\"value\"],\n",
    "        duration_months=doc_data[\"duration\"],\n",
    "        client_name=doc_data[\"client\"],\n",
    "        key_outcomes=doc_data[\"outcomes\"],\n",
    "        consulting_approach=doc_data[\"approach\"]\n",
    "    )\n",
    "    kb.add_document(doc)\n",
    "\n",
    "print(f\"✓ Knowledge base initialized with {len(kb.list_documents())} consulting engagements\")\n",
    "print(f\"\\nEngagements by industry:\")\n",
    "for industry in set(d.industry for d in kb.list_documents() if d.industry):\n",
    "    count = len(kb.filter_by_industry(industry))\n",
    "    print(f\"  - {industry}: {count} engagement(s)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Semantic Search & Embeddings\n",
    "\n",
    "Search the knowledge base for similar engagements."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize embeddings manager\n",
    "embeddings = EmbeddingsManager(kb)\n",
    "\n",
    "# Perform semantic search\n",
    "query = \"We need to optimize our technology infrastructure and reduce operational costs\"\n",
    "print(f\"Search Query: '{query}'\\n\")\n",
    "\n",
    "results = embeddings.semantic_search(query, top_k=3)\n",
    "\n",
    "print(\"Search Results:\")\n",
    "print(\"-\" * 80)\n",
    "for i, result in enumerate(results, 1):\n",
    "    doc = result.document\n",
    "    print(f\"\\n{i}. {doc.title}\")\n",
    "    print(f\"   Industry: {doc.industry}\")\n",
    "    print(f\"   Type: {doc.transaction_type}\")\n",
    "    print(f\"   Relevance: {result.similarity_score:.0%}\")\n",
    "    print(f\"   Value: ${doc.engagement_value}M | Duration: {doc.duration_months} months\")\n",
    "    print(f\"   Outcomes: {doc.key_outcomes[:100]}...\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Recommendations Engine\n",
    "\n",
    "Get intelligent recommendations based on similar past engagements."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize recommendation engine\n",
    "recommender = RecommendationEngine(embeddings)\n",
    "\n",
    "# Get recommendations\n",
    "engagement_desc = \"\"\"Our fintech startup needs to optimize core banking infrastructure \n",
    "and reduce operational costs while maintaining security and compliance.\n",
    "Industry: Financial Services | Type: Restructuring\"\"\"\n",
    "\n",
    "print(f\"Engagement: {engagement_desc.replace(chr(10), ' ')}\\n\")\n",
    "\n",
    "recommendations = recommender.recommend_similar_engagements(engagement_desc, top_k=3)\n",
    "\n",
    "print(\"\\nRecommended Similar Engagements:\")\n",
    "print(\"=\" * 80)\n",
    "for i, rec in enumerate(recommendations, 1):\n",
    "    doc = rec.reference_document\n",
    "    print(f\"\\n{i}. {doc.title}\")\n",
    "    print(f\"   Relevance Score: {rec.relevance_score:.0%}\")\n",
    "    print(f\"   Reasoning: {rec.reasoning}\")\n",
    "    if rec.suggested_approach:\n",
    "        print(f\"   Suggested Approach: {rec.suggested_approach}\")\n",
    "    if rec.potential_challenges:\n",
    "        print(f\"   Potential Challenges: {rec.potential_challenges[:80]}...\")\n",
    "    if rec.estimated_effort:\n",
    "        print(f\"   Estimated Effort: {rec.estimated_effort}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Knowledge Synthesis & Insights\n",
    "\n",
    "Generate strategic insights and recommendations for new engagements."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize synthesizer\n",
    "synthesizer = KnowledgeSynthesizer(kb, recommender)\n",
    "\n",
    "# Generate synthesis\n",
    "new_engagement = \"\"\"Mid-market healthcare provider undergoing digital transformation.\n",
    "Need to modernize legacy systems, improve patient data access, and ensure HIPAA compliance.\n",
    "Target: 25% cost reduction, 50% faster claims processing.\"\"\"\n",
    "\n",
    "print(\"New Engagement:\")\n",
    "print(f\"{new_engagement}\\n\")\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"SYNTHESIS & STRATEGIC INSIGHTS\")\n",
    "print(\"=\" * 80 + \"\\n\")\n",
    "\n",
    "synthesis = synthesizer.synthesize_recommendations(new_engagement, top_k=3)\n",
    "print(synthesis)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Industry Analysis\n",
    "\n",
    "Analyze trends and patterns across an industry."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze Technology industry\n",
    "print(\"\\nINDUSTRY ANALYSIS: TECHNOLOGY\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "tech_analysis = synthesizer.analyze_industry_trends(\"Technology\")\n",
    "print(tech_analysis)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze Financial Services industry\n",
    "print(\"\\nINDUSTRY ANALYSIS: FINANCIAL SERVICES\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "fs_analysis = synthesizer.analyze_industry_trends(\"Financial Services\")\n",
    "print(fs_analysis)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Knowledge Base Summary\n",
    "\n",
    "View the complete knowledge base inventory."
   ]
  },
  {
   "cell_type": "code">
   "metadata": {},
   "source": [
    "# Knowledge base statistics\n",
    "docs = kb.list_documents()\n",
    "industries = set(d.industry for d in docs if d.industry)\n",
    "types = set(d.transaction_type for d in docs if d.transaction_type)\n",
    "total_value = sum(d.engagement_value or 0 for d in docs)\n",
    "avg_duration = sum(d.duration_months or 0 for d in docs) / len(docs) if docs else 0\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"KNOWLEDGE BASE SUMMARY\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"\\nTotal Documents: {len(docs)}\")\n",
    "print(f\"Total Engagement Value: ${total_value:.1f}M\")\n",
    "print(f\"Average Duration: {avg_duration:.1f} months\")\n",
    "print(f\"\\nIndustries: {', '.join(sorted(industries))}\")\n",
    "print(f\"Transaction Types: {', '.join(sorted(types))}\")\n",
    "\n",
    "print(\"\\n\" + \"-\" * 80)\n",
    "print(\"Documents:\")\n",
    "print(\"-\" * 80)\n",
    "for doc in sorted(docs, key=lambda d: d.created_at, reverse=True):\n",
    "    print(f\"\\n• {doc.title}\")\n",
    "    print(f\"  ID: {doc.id[:16]}... | Industry: {doc.industry} | Type: {doc.transaction_type}\")\n",
    "    print(f\"  Value: ${doc.engagement_value}M | Duration: {doc.duration_months} months\")"
   ]
  },
  {
   "cell_type": "markdown",
